  chatDataList:
  - id: 0
    content: "\uC624\uB298\uC740 \uC774\uC0AC \uCCAB\uB0A0\uC774\uC57C. \uC0C8\uC9D1\uC5D0
      \uB4E4\uC5B4\uAC00\uBCF4\uC790!"
  - id: 10
    content: "\uC9D1\uC5D0 \uC788\uB294 \uC0C1\uC790\uB97C \uBAA8\uB450 \uCE58\uC6B0\uC790."
  - id: 101
    content: "\uC9D0\uC744 \uB2E4 \uCE58\uC6E0\uC73C\uB2C8 \uC774\uC81C \uC53B\uC5B4\uC57C\uC9C0.
      \uC138\uC218\uBD80\uD130 \uD560\uAE4C?"
  - id: 100
    content: "\uB2E4 \uC53B\uC5C8\uC73C\uB2C8\uAE4C \uC774\uC81C \uC790\uBCFC\uAE4C?"
  - id: 1
    content: "\uC624\uB298 \uC2E0\uBB38 \uC624\uB294 \uB0A0\uC774\uB124. \uC774 \uB3D9\uB124\uB294
      \uC5B4\uB5A4 \uC77C\uC774 \uC788\uB294\uC9C0 \uD655\uC778\uD574\uBCF4\uC790."
  - id: 20
    content: "\uC65C \uC0C1\uC790\uAC00 \uB0A8\uC544\uC788\uC9C0? \uB2E4\uC2DC \uCE58\uC6B0\uC790."
  - id: 21
    content: "\uD2F0\uBE44 \uC55E \uCC45\uC0C1\uC5D0\uB3C4 \uBB34\uC5B8\uAC00 \uC788\uB294
      \uAC83 \uAC19\uC544."
  - id: 110
    content: "\uD654\uC7A5\uC2E4 \uC4F0\uB808\uAE30\uD1B5\uC5D0 \uBB34\uC5B8\uAC00
      \uC788\uB294 \uAC83 \uAC19\uC544. \uD655\uC778\uD574\uBCF4\uC790."
  - id: 2
    content: "\uC5B4\uC81C \uC7A0\uC790\uB9AC\uAC00 \uB108\uBB34 \uBB34\uC11C\uC6E0\uC5B4.
      \uC5B4\uC81C \uBCF8 \uC2E0\uBB38 \uAE30\uC0AC\uAC00 \uC0DD\uAC01\uB098\uB124"
  - id: 30
    content: "\uC5B4\uC81C \uCE58\uC6E0\uB358 \uC0C1\uC790\uAC00 \uB610 \uC788\uB124.
      \uB2E4\uC2DC \uCE58\uC6B0\uC790..."
  - id: 140
    content: "\uC815\uC804\uC778 \uAC83 \uAC19\uC544. \uB2E4\uC2DC \uBD88\uC744 \uCF1C\uBCF4\uC790."
  - id: 40
    content: "\uADF8\uB9CC\uD558\uACE0 \uC790\uC790."
  - id: 50
    content: "\uC804\uD654\uAC00 \uC624\uACE0\uC788\uC5B4. \uD734\uB300\uD3F0\uC774
      \uC5B4\uB528\uB294\uC9C0 \uCC3E\uC544\uBCF4\uC790."
  - id: 160
    content: "\uAC11\uC790\uAE30 \uBB3C\uC774 \uCC28\uC62C\uB77C\uC11C \uB180\uB790\uC5B4."
  - id: 70
    content: "\uC55E\uC774 \uB9C9\uD600\uC788\uC5B4."
